// CertiFlow data model.
// Constraints that Prisma's schema language cannot express (partial unique index on
// active approvals, append-only trigger on AuditLog, CHECK constraints) live in the
// hand-written section at the end of the first migration. See docs/DECISIONS.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CENTRE
  DISTRICT_OFFICER
  QUALITY
  STATE
}

enum BatchStatus {
  DRAFT
  PENDING_DISTRICT
  PENDING_QUALITY
  PENDING_STATE
  SENT_BACK
  REJECTED
  APPROVED
  ISSUING
  ISSUED
  PARTIALLY_ISSUED
}

enum ReviewStep {
  DISTRICT
  QUALITY
  STATE
}

enum ReviewDecision {
  APPROVE
  REJECT
  SEND_BACK
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  DEAD
}

model District {
  id      String           @id @default(uuid()) @db.Uuid
  name    String           @unique
  code    String           @unique
  centres TrainingCentre[]
  users   User[]
  batches Batch[]
}

model TrainingCentre {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  batches    Batch[]

  @@index([districtId])
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  /// Stable demo key used by the role switcher (e.g. "anika").
  key            String          @unique
  name           String
  email          String          @unique
  role           Role
  districtId     String?         @db.Uuid
  district       District?       @relation(fields: [districtId], references: [id])
  centreId       String?         @db.Uuid
  centre         TrainingCentre? @relation(fields: [centreId], references: [id])
  createdAt      DateTime        @default(now())
  batchesCreated Batch[]         @relation("BatchCreatedBy")
  approvals      Approval[]
  revocations    Certificate[]   @relation("CertificateRevokedBy")
}

model Batch {
  id                   String         @id @default(uuid()) @db.Uuid
  centreId             String         @db.Uuid
  centre               TrainingCentre @relation(fields: [centreId], references: [id])
  districtId           String         @db.Uuid
  district             District       @relation(fields: [districtId], references: [id])
  courseName           String
  status               BatchStatus    @default(DRAFT)
  /// Increments on every submission; approvals are tied to a revision.
  revision             Int            @default(0)
  /// Optimistic-concurrency counter; every write does WHERE version = expected.
  version              Int            @default(0)
  candidateCount       Int            @default(0)
  createdById          String         @db.Uuid
  createdBy            User           @relation("BatchCreatedBy", fields: [createdById], references: [id])
  sendBackReason       String?
  submittedAt          DateTime?
  currentStepEnteredAt DateTime?
  slaBreachedAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  candidates           Candidate[]
  approvals            Approval[]
  certificates         Certificate[]

  @@index([centreId, status])
  @@index([districtId, status])
  @@index([status, currentStepEnteredAt])
}

model Candidate {
  id          String       @id @default(uuid()) @db.Uuid
  batchId     String       @db.Uuid
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fullName    String
  /// E.164, e.g. +919876543210
  phone       String
  enrolmentId String
  dob         DateTime?    @db.Date
  score       Int
  passedOn    DateTime     @db.Date
  createdAt   DateTime     @default(now())
  certificate Certificate?

  @@unique([batchId, enrolmentId])
}

/// Every review decision (approve / reject / send back). Never deleted:
/// withdrawals set withdrawnAt, resubmissions set superseded.
model Approval {
  id          String         @id @default(uuid()) @db.Uuid
  batchId     String         @db.Uuid
  batch       Batch          @relation(fields: [batchId], references: [id])
  revision    Int
  step        ReviewStep
  officerId   String         @db.Uuid
  officer     User           @relation(fields: [officerId], references: [id])
  decision    ReviewDecision
  reason      String?
  superseded  Boolean        @default(false)
  withdrawnAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([batchId, revision, step])
}

model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  certificateNumber String            @unique
  /// One certificate per candidate, enforced by the database.
  candidateId       String            @unique @db.Uuid
  candidate         Candidate         @relation(fields: [candidateId], references: [id])
  batchId           String            @db.Uuid
  batch             Batch             @relation(fields: [batchId], references: [id])
  pdfKey            String
  pdfSha256         String
  /// SHA-256 of the canonical certificate data; printed on the PDF.
  contentHash       String
  /// SHA-256 of the download token; the raw token is never stored.
  downloadTokenHash String            @unique
  status            CertificateStatus @default(ISSUED)
  issuedAt          DateTime          @default(now())
  revokedAt         DateTime?
  revokedById       String?           @db.Uuid
  revokedBy         User?             @relation("CertificateRevokedBy", fields: [revokedById], references: [id])
  revokeReason      String?
  deliveries        Delivery[]

  @@index([batchId])
}

model Delivery {
  id                String            @id @default(uuid()) @db.Uuid
  certificateId     String            @db.Uuid
  certificate       Certificate       @relation(fields: [certificateId], references: [id])
  channel           String            @default("WHATSAPP")
  /// Bumped only when the provider reports a definite failure and we must resend.
  generation        Int               @default(1)
  idempotencyKey    String            @unique
  providerMessageId String?
  status            DeliveryStatus    @default(PENDING)
  attempts          Int               @default(0)
  lastError         String?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attemptLog        DeliveryAttempt[]

  @@unique([certificateId, channel])
  @@index([status])
  @@index([providerMessageId])
}

model DeliveryAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  deliveryId     String   @db.Uuid
  delivery       Delivery @relation(fields: [deliveryId], references: [id])
  attemptNo      Int
  idempotencyKey String
  outcome        String
  httpStatus     Int?
  error          String?
  createdAt      DateTime @default(now())

  @@index([deliveryId])
}

/// Append-only. A database trigger rejects UPDATE and DELETE.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  actorRole     String
  action        String
  entityType    String
  entityId      String
  batchId       String?  @db.Uuid
  fromState     String?
  toState       String?
  reason        String?
  metadata      Json     @default("{}")
  correlationId String
  createdAt     DateTime @default(now())

  @@index([batchId, createdAt])
  @@index([entityType, entityId])
}

/// Transactional outbox: written in the same transaction as the state change,
/// relayed to BullMQ + Socket.IO by the worker.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  correlationId String
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
}
