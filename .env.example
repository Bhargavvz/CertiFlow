# Copy to .env for local (non-Docker) development. docker-compose.yml has safe demo
# defaults for every value, so `docker compose up --build` works without a .env file.
# NEVER use these secrets outside a demo.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow
REDIS_URL=redis://localhost:6379/0

# Auth (JWT in an httpOnly cookie). Must be >= 32 chars.
JWT_SECRET=change-me-change-me-change-me-change-me-0123
JWT_TTL_SECONDS=28800
COOKIE_SECURE=false
DEMO_LOGIN_ENABLED=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Public URL that QR codes and WhatsApp links point to (the web app; nginx proxies /api)
PUBLIC_WEB_URL=http://localhost:8080

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=certiflow
S3_SECRET_KEY=certiflow-secret
S3_BUCKET=certificates

# WhatsApp provider (the mock in apps/mock-whatsapp)
WHATSAPP_API_URL=http://localhost:4000
WHATSAPP_API_TOKEN=demo-provider-token
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret-0123456789
WHATSAPP_TIMEOUT_MS=3000
WHATSAPP_MAX_ATTEMPTS=8
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000

# HMAC key that derives certificate download tokens
DOWNLOAD_TOKEN_SECRET=change-me-download-secret-0123456789

# Workflow
QUALITY_THRESHOLD=50
SLA_HOURS=48
# Set e.g. 120 to make the SLA 2 minutes for a demo. Empty = use SLA_HOURS.
SLA_OVERRIDE_SECONDS=
SLA_SWEEP_EVERY_MS=30000

# Caching / limits
VERIFY_CACHE_TTL_SECONDS=300
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_VERIFY_PER_MIN=60
RATE_LIMIT_DOWNLOAD_PER_MIN=30
MAX_UPLOAD_BYTES=2097152
MAX_IMPORT_ROWS=1000

# Worker
OUTBOX_POLL_MS=250
CERT_CONCURRENCY=4
SEND_CONCURRENCY=10

# Mock WhatsApp provider (apps/mock-whatsapp)
MOCK_PORT=4000
MOCK_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/whatsapp
MOCK_FAIL_500=0.2
MOCK_FAIL_TIMEOUT=0.1
MOCK_FAIL_429=0.05
MOCK_WEBHOOK_FAIL=0.02
MOCK_LATENCY_MIN_MS=50
MOCK_LATENCY_MAX_MS=400
MOCK_WEBHOOK_DELAY_MS=800
MOCK_HANG_MS=10000
